# Copy to .env and fill in.

# --- Database (Prisma) ---
# Local dev uses SQLite (zero install). Leave this as-is for local development.
DATABASE_URL="file:./dev.db"
# On the hosted pilot/production, the build switches the datasource to PostgreSQL
# and DATABASE_URL must be a Postgres connection string, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Auth ---
# Secret used to sign session cookies. Use a long random string (32+ chars) in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# --- First-run admin (optional) ---
# Password for the seeded admin@wandb.ae account, applied only when it is first created.
# Set this on the hosted environment so the demo password is never used there.
ADMIN_PASSWORD="admin123"

# --- Querying the hosted database (optional, local only) ---
# Public Postgres URL from Railway (Postgres service -> Variables -> DATABASE_PUBLIC_URL).
# Used by `npm run db:prod` to open Prisma Studio against the hosted data.
# Prefer a read-only role — see DEPLOY.md, "Querying the hosted database".
# PROD_DATABASE_URL="postgresql://reporting:password@viaduct.proxy.rlwy.net:41234/railway"
