# Copy to .env and fill in.
# Prisma database connection. SQLite for local dev, Postgres for production.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/wb_erp?schema=public"

# Secret used to sign session JWTs. Use a long random string (32+ chars) in production.
AUTH_SECRET="change-me-to-a-long-random-string"
