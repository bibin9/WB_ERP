// White & Bright Group ERP — Phase 1 foundation schema
// Product-ready: every row is scoped to a Tenant (customer) and, where
// relevant, a Company (legal entity within the customer's group).

generator client {
  provider = "prisma-client-js"
}

// Money is stored as Float (a double), not Decimal, and that is deliberate.
//
// Doubles are the usual accounting foot-gun, so the question was measured
// rather than assumed: balanced pairs are bit-identical and never diverge, and
// 200,000 stored amounts summed in opposite orders differ by 7e-5 — four orders
// of magnitude below a fils. Reaching one fils of drift needs tens of millions
// of rows, far beyond what this system will hold.
//
// The defect that was real is different: storing a value that is not an amount
// of money at all. A VAT extraction gives 1119.571428…, the screen shows
// 1,119.57, and a report that sums before rounding then disagrees with one that
// rounds before summing. Every write now goes through toFils() in lib/money.ts,
// which fixes that at the source.
//
// Converting these columns to Decimal would mean rewriting 33 columns on a live
// database, touching ~130 arithmetic sites, and handling Decimal across 12
// server-to-client boundaries where it does not serialise — materially more
// risk than it removes. Revisit if the ledger ever reaches millions of rows.
datasource db {
  // SQLite for zero-install local dev. Switch to "postgresql" for production
  // (change provider + DATABASE_URL; JSON-in-String fields stay compatible).
  provider = "postgresql"
  url      = env("MIGRATION_DATABASE_URL")
}

/// A customer of the product (white-label). White & Bright is one tenant.
model Tenant {
  id             String           @id @default(cuid())
  key            String           @unique // e.g. "wandb"
  name           String
  // Branding (mirrors src/config/tenant.ts so it can move to the DB later)
  logoUrl        String?
  theme          String? // JSON string: { navy, blue, green, gold, paper } as RGB triplets
  companies      Company[]
  users          User[]
  roles          Role[]
  approvalRoutes ApprovalRoute[]
  customFields   CustomFieldDef[]
  masterItems    MasterItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

/// A legal company within a tenant's group (multi-company).
model Company {
  id               String               @id @default(cuid())
  tenantId         String
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code             String
  name             String
  baseCurrency     String               @default("AED")
  // UAE WPS (Wage Protection System) employer details, used to generate the bank SIF file
  wpsEmployerId    String? // MOL establishment / employer unique ID
  /// Month the financial year starts (1 = January).
  fyStartMonth     Int                  @default(1)
  /// Nothing may be posted on or before this date. Set after a VAT return is
  /// filed or a period is closed, so the figures behind it cannot move.
  booksLockedTo    DateTime?
  /// Date the opening balances are stated as at — normally the FY start.
  openingAsOf      DateTime?
  /// The company's own letterhead logo, shown at the top of every printed
  /// report for this company.
  ///
  /// Held as a data URI rather than a file on disk, because the container's
  /// filesystem does not survive a deploy and a report that silently loses its
  /// letterhead is worse than one that never had it. A logo is a few kilobytes,
  /// which a text column carries comfortably. A plain https:// URL is accepted
  /// too, for a company that already hosts its mark somewhere.
  logoUrl          String?
  /// Corporate Tax Registration Number, issued by the FTA when the company
  /// registers for corporate tax. Separate from the VAT TRN: a company can be
  /// registered for one and not the other, and the return quotes this one.
  corporateTaxTRN  String?
  parties          Party[]
  taxReturns       CorporateTaxReturn[]
  jobs             Job[]
  costCentres      CostCentre[]
  cheques          Cheque[]
  retentions       Retention[]
  wpsBankRouting   String? // employer bank routing code (agent ID)
  isActive         Boolean              @default(true)
  memberships      CompanyMembership[]
  jobAssignments   JobAssignment[]
  approvalRequests ApprovalRequest[]
  accounts         ChartOfAccount[]
  journalEntries   JournalEntry[]
  employees        Employee[]
  requisitions     Requisition[]
  payrollRuns      PayrollRun[]
  leaveRequests    LeaveRequest[]
  createdAt        DateTime             @default(now())

  @@unique([tenantId, code])
  @@index([tenantId])
}

model User {
  id                String              @id @default(cuid())
  tenantId          String
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email             String
  name              String
  passwordHash      String?
  isActive          Boolean             @default(true)
  // Account security
  failedAttempts    Int                 @default(0) // consecutive wrong-password count
  lockedUntil       DateTime? // account is locked while this is in the future
  mustReset         Boolean             @default(false) // force a password change on next sign-in
  passwordChangedAt DateTime?
  memberships       CompanyMembership[]
  notifications     Notification[]
  createdAt         DateTime            @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
}

/// Which companies a user can access, and with what role (RBAC + company scope).
model CompanyMembership {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role    @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
}

model Role {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String // e.g. "Group Admin", "Project Manager", "Director"
  // Permissions as JSON string: { "module": ["create","read","update","delete","approve"] }
  permissions   String              @default("{}")
  approvalLevel Int                 @default(0) // sign-off rank (higher = more authority)
  memberships   CompanyMembership[]

  @@unique([tenantId, name])
}

/// HR & Admin — Job Assignments / task tickets (FSD HR-18…23).
model JobAssignment {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ticketNo       String
  title          String
  description    String?
  priority       String    @default("Normal") // Low | Normal | High | Urgent
  assignedToType String    @default("person") // "person" | "department"
  assignedTo     String // person name or department
  assignedBy     String
  dueDate        DateTime?
  timeAllocation String? // e.g. "4h", "2d"
  status         String    @default("Open") // Open | In Progress | Completed | Closed
  remarks        String?
  closedBy       String?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, ticketNo])
  @@index([companyId])
}

/// Approval Engine (FSD FS-PLT-02) — one configurable sign-off workflow reused
/// by any document type (PO, expense, company onboarding, etc.).
model ApprovalRequest {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  docType     String // e.g. "Purchase Order", "Expense", "Company Onboarding"
  title       String
  amount      Float?
  currency    String         @default("AED")
  requestedBy String
  status      String         @default("Pending") // Pending | Approved | Rejected
  currentStep Int            @default(1)
  steps       ApprovalStep[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([companyId])
}

model ApprovalStep {
  id            String          @id @default(cuid())
  requestId     String
  request       ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order         Int // 1-based position in the route
  roleName      String // approver role for this level
  requiredLevel Int // minimum approval level required to act
  status        String          @default("Pending") // Pending | Approved | Rejected
  decidedBy     String?
  decidedAt     DateTime?
  comment       String?

  @@index([requestId])
}

/// Finance — Chart of Accounts (per company; each company keeps its own books).
model ChartOfAccount {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code           String // e.g. "1000"
  name           String // e.g. "Cash at Bank"
  type           String // Asset | Liability | Equity | Income | Expense
  parentGroup    String? // Tally-style group, e.g. "Current Assets", "Sundry Debtors"
  /// Balance carried in when the books were migrated. Debit positive,
  /// credit negative — the sign convention the ledgers already use.
  openingBalance Float         @default(0)
  /// "Receivable" or "Payable" marks this as a control account, which is what
  /// the outstanding and ageing report measures against.
  controlType    String?
  tallyGuid      String? // mapping key when synced from Tally
  isActive       Boolean       @default(true)
  lines          JournalLine[]
  createdAt      DateTime      @default(now())

  @@unique([companyId, code])
  @@index([companyId])
}

/// Finance — double-entry journal entry (header + balanced lines).
model JournalEntry {
  id           String         @id @default(cuid())
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reference    String
  voucherType  String         @default("Journal") // Journal | Payment | Receipt | Contra | Sales | Purchase
  date         DateTime       @default(now())
  memo         String?
  partyName    String?
  partyId      String?
  party        Party?         @relation(fields: [partyId], references: [id]) // party ledger (customer/supplier) for the voucher
  vatAmount    Float          @default(0) // UAE VAT (5%) portion, if any
  source       String         @default("manual") // manual | tally
  /// What produced this voucher, when it was not typed by hand: the module
  /// and the document inside it. Lets a voucher be traced back to the goods
  /// receipt or payroll run behind it, and stops the same document posting
  /// twice — the unique index below is the guard.
  ///
  /// e.g. sourceType "grn", sourceId the receipt's id.
  sourceType   String?
  sourceId     String?
  /// A reversal points back at the voucher it cancels, so both sides of the
  /// correction stay visible in the audit trail.
  ///
  /// Modelled one-to-many rather than one-to-one on purpose: a one-to-one would
  /// need a unique constraint, and adding one to a live table makes `db push`
  /// refuse without --accept-data-loss, which is not a flag to leave pointed at
  /// a client's database. "Reverse only once" is enforced in the action, and the
  /// constraint can be restored properly once this moves to migrations.
  reversalOfId String?
  reversalOf   JournalEntry?  @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry[] @relation("Reversal")
  postedBy     String
  lines        JournalLine[]
  createdAt    DateTime       @default(now())
  timesheets   Timesheet[]
  cheques      Cheque[]
  retentions   Retention[]

  @@unique([companyId, reference])
  @@unique([companyId, sourceType, sourceId])
  @@index([companyId])
}

model JournalLine {
  id        String         @id @default(cuid())
  entryId   String
  entry     JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   ChartOfAccount @relation(fields: [accountId], references: [id])
  debit     Float          @default(0)
  credit    Float          @default(0)

  /// How this line is treated for UAE VAT. A single invoice often mixes them —
  /// standard-rated work alongside a zero-rated export or a designated-zone
  /// supply — so the treatment belongs on the line, not on the voucher.
  ///
  /// Standard | Zero-rated | Exempt | Out of scope | Reverse charge
  /// Null means the line is not a supply or expense at all: the receivable, the
  /// bank, the VAT control account itself.
  vatTreatment String?
  /// The job this line belongs to. Costs and revenue are tagged on the line,
  /// not the voucher, because one supplier invoice often covers two jobs.
  jobId        String?
  job          Job?        @relation(fields: [jobId], references: [id])
  /// The part of the business that carried this line when no single job did —
  /// the workshop, the vehicles, admin. Without it, "not yet tagged to a job"
  /// and "a genuine overhead" are the same empty field, and neither departmental
  /// P&L nor a trustworthy untagged-cost figure is possible.
  costCentreId String?
  costCentre   CostCentre? @relation(fields: [costCentreId], references: [id])

  /// The date the bank actually showed this line, when it has been reconciled.
  ///
  /// A cheque written on the 28th may not leave the account until the 4th, and
  /// until it does the ledger and the statement disagree for a perfectly good
  /// reason. Marking the line cleared is what separates "not on the statement
  /// yet" from "not on the statement because something is wrong" — and without
  /// that distinction the bank balance can drift for a year before anyone
  /// notices.
  clearedOn    DateTime?
  /// Which statement it was ticked against, so a past reconciliation can be
  /// reopened and shown to an auditor.
  statementRef String?

  @@index([entryId])
  @@index([accountId])
  @@index([jobId])
  @@index([costCentreId])
  @@index([clearedOn])
}

/// Admin-configurable approval routes (per tenant). Replaces the code config:
/// each customer configures their own sign-off chains via the UI, no code changes.
model ApprovalRoute {
  id        String              @id @default(cuid())
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  docType   String // e.g. "Purchase Order"
  isActive  Boolean             @default(true)
  steps     ApprovalRouteStep[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([tenantId, docType])
  @@index([tenantId])
}

model ApprovalRouteStep {
  id            String        @id @default(cuid())
  routeId       String
  route         ApprovalRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  order         Int
  roleName      String
  requiredLevel Int
  minAmount     Float? // step applies only when amount >= minAmount (null = always)

  @@index([routeId])
}

/// HR & Admin — Employee master data (Phase 1). Includes basic payroll master
/// data (salary structure); payroll processing itself is Phase 3.
model Employee {
  id                 String             @id @default(cuid())
  companyId          String
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  empNo              String
  name               String
  email              String?
  phone              String?
  biometricId        String? // enrolment/user ID on the punch machine (maps device logs to this employee)
  department         String?
  designation        String?
  grade              String?
  employmentType     String             @default("Full-time") // Full-time | Part-time | Contract | Supplied
  joinDate           DateTime?
  status             String             @default("Active") // Active | On Leave | Inactive
  // Payroll master data (structure only — processing is Phase 3)
  basicSalary        Float              @default(0)
  allowances         Float              @default(0)
  /// Cost to the business for one hour of this person's time. Left blank it is
  /// derived from pay; set it when the real cost differs — a supplied worker
  /// billed at an agency rate, or someone whose package is not the true cost.
  hourlyCost         Float?
  currency           String             @default("AED")
  annualLeaveBalance Int                @default(30)
  supplier           String? // agency/sponsor for supplied manpower (HR-15)
  // Personal
  dateOfBirth        DateTime?
  gender             String?
  nationality        String?
  maritalStatus      String?
  bloodGroup         String?
  personalEmail      String?
  address            String?
  emergencyName      String?
  emergencyPhone     String?
  // Employment / contract
  /// Limited-term is the only kind Federal Decree-Law 33/2021 allows. The
  /// column keeps its width for records migrated from before February 2022.
  contractType       String? // Limited
  contractEndDate    DateTime?
  /// The last day a leaver is on the payroll. Without it a part month cannot
  /// be worked out, and a man who leaves on the 12th is either paid for the
  /// whole month or — if he is marked Inactive first — for none of it.
  lastWorkingDay     DateTime?
  // UAE documents
  emiratesIdNo       String?
  emiratesIdExpiry   DateTime?
  passportNo         String?
  passportExpiry     DateTime?
  visaNo             String?
  visaType           String?
  visaExpiry         DateTime?
  labourCardNo       String?
  labourCardExpiry   DateTime?
  // Banking (WPS)
  bankName           String?
  iban               String?
  bankRoutingCode    String? // employee bank routing code (agent ID) for the WPS SIF
  onboarding         OnboardingItem[]
  leaveRequests      LeaveRequest[]
  attendance         Attendance[]
  certifications     Certification[]
  timesheets         Timesheet[]
  appraisals         Appraisal[]
  documents          EmployeeDocument[]
  customValues       CustomFieldValue[]
  separations        Separation[]
  advances           Advance[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([companyId, empNo])
  @@index([companyId])
}

/// Notifications / Alerts engine (FSD FS-PLT-03) — in-app notifications per user.
model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("info") // approval | task | info
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

/// Audit Trail (FSD FS-PLT-05) — who did what and when on key transactions.
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  userName  String
  action    String // Created | Updated | Approved | Rejected | Deleted | Posted
  entity    String // Company | User | JournalEntry | ApprovalRequest | Employee | JobAssignment | ApprovalRoute
  entityId  String?
  summary   String
  createdAt DateTime @default(now())

  @@index([tenantId])
}

/// HR — Recruitment & Onboarding (FSD HR-09…11)
model Requisition {
  id         String      @id @default(cuid())
  companyId  String
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  position   String
  department String?
  headcount  Int         @default(1)
  status     String      @default("Open") // Open | Interviewing | Offered | Filled | Closed
  raisedBy   String
  candidates Candidate[]
  createdAt  DateTime    @default(now())

  @@index([companyId])
}

model Candidate {
  id            String      @id @default(cuid())
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  name          String
  email         String?
  phone         String?
  stage         String      @default("Applied") // Applied | Interview | Offer | Hired | Rejected
  visaType      String? // Employment | Mission | Local | ...
  notes         String?
  createdAt     DateTime    @default(now())

  @@index([requisitionId])
}

/// Onboarding checklist items per employee (HR-11)
model OnboardingItem {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  label      String
  done       Boolean  @default(false)
  order      Int

  @@index([employeeId])
}

/// HR — Payroll processing (FSD HR-07…08)
model PayrollRun {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period    String // "2026-08"
  status    String    @default("Draft") // Draft | Approved | Paid
  runBy     String
  payslips  Payslip[]
  createdAt DateTime  @default(now())

  @@unique([companyId, period])
  @@index([companyId])
}

model Payslip {
  id                 String     @id @default(cuid())
  runId              String
  run                PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId         String
  empNo              String
  employeeName       String
  /// Basic and allowances as paid — already reduced for a part month.
  basic              Float
  allowances         Float
  /// The contractual monthly figures, kept so a part month can be read back and
  /// explained without hunting for the employee record as it was that month.
  contractBasic      Float      @default(0)
  contractAllowances Float      @default(0)
  /// Days paid out of the days the month holds. Equal on a full month.
  daysPaid           Float      @default(0)
  daysInPeriod       Int        @default(30)
  /// Why it was a part month — "joined 2026-09-20", "last working day
  /// 2026-09-12" — so nobody has to work it out from the numbers.
  partMonthReason    String?
  otHours            Float      @default(0)
  otPremiumHours     Float      @default(0)
  overtime           Float      @default(0)
  /// Days lost to unpaid leave, the unpaid half of sick leave, and unexcused
  /// absence — and what those days cost.
  unpaidDays         Float      @default(0)
  deductions         Float      @default(0) // absence and unpaid leave, computed
  /// Fines and anything else HR enters by hand, with a note saying what it was.
  otherDeductions    Float      @default(0)
  deductionNote      String?
  advanceRecovery    Float      @default(0) // salary-advance / loan installment recovered this run
  netPay             Float

  @@index([runId])
}

/// HR — Salary advances / loans, recovered through payroll
model Advance {
  id              String   @id @default(cuid())
  companyId       String
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeName    String
  amount          Float // original amount advanced
  monthlyRecovery Float // installment recovered each payroll run
  balance         Float // outstanding balance
  reason          String?
  status          String   @default("Active") // Active | Cleared
  createdAt       DateTime @default(now())

  @@index([companyId])
  @@index([employeeId])
}

/// HR — Leave management (FSD HR-03…06)
model LeaveRequest {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String // Annual | Sick | Unpaid | Comp-Off
  fromDate   DateTime
  toDate     DateTime
  days       Int
  reason     String?
  status     String   @default("Pending") // Pending | Approved | Rejected
  decidedBy  String?
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([employeeId])
}

/// HR — Time & Attendance (FSD HR-02)
model Attendance {
  id             String   @id @default(cuid())
  companyId      String
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime
  status         String   @default("Present") // Present | Absent | Leave | Off | Half-day
  hours          Float    @default(8)
  /// Overtime past the eighth hour, at 125% of basic.
  otHours        Float    @default(0)
  /// Overtime at 150%: hours between 22:00 and 04:00, a rest day, or a public
  /// holiday taken as pay rather than a day off. Held apart from otHours
  /// because the two are priced differently and a payslip has to show which.
  otPremiumHours Float    @default(0)
  remarks        String?
  createdAt      DateTime @default(now())

  @@unique([employeeId, date])
  @@index([companyId])
}

/// HR — Employee separation (resignation / termination) + UAE end-of-service settlement
model Separation {
  id             String   @id @default(cuid())
  companyId      String
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           String // Resignation | Termination | Termination (Misconduct)
  lastWorkingDay DateTime
  reason         String?
  // Settlement snapshot (UAE Labour Law) — stored so the record is a fixed statement
  basicSalary    Float
  serviceText    String // e.g. "3y 2m 10d"
  serviceYears   Float
  gratuityDays   Float    @default(0)
  gratuityAmount Float    @default(0)
  leaveDays      Float    @default(0)
  leaveAmount    Float    @default(0)
  pendingSalary  Float    @default(0)
  noticePay      Float    @default(0)
  airTicket      Float    @default(0)
  otherAdditions Float    @default(0)
  deductions     Float    @default(0)
  adjustment     Float    @default(0) // HR manual +/- tweak
  adjustmentNote String?
  netSettlement  Float    @default(0)
  status         String   @default("Draft") // Draft | Approved | Settled
  processedBy    String?
  createdAt      DateTime @default(now())

  @@index([companyId])
  @@index([employeeId])
}

/// HR — Competency certifications & medical clearances (FSD HR-12,13,16)
model Certification {
  id         String    @id @default(cuid())
  companyId  String
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String
  category   String    @default("Competency") // Competency | Safety | Medical
  issuedBy   String?
  issueDate  DateTime?
  expiryDate DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([companyId])
  @@index([employeeId])
}

/// HR — Project timesheets (FSD HR-17). projectRef is free text until Projects (P3) links it.
/// Time an employee spent on a job.
///
/// Until this carried a job and a rate, labour never reached job costing: the
/// hours were recorded, the salary was posted to the P&L, and the job showed
/// only its material and subcontract cost. For a technical-services contractor
/// labour is usually the largest cost on a job, so every margin was overstated.
model Timesheet {
  id         String        @id @default(cuid())
  companyId  String
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  /// The job this time was spent on. Nullable because entries made before
  /// timesheets carried a job still have to be readable.
  jobId      String?
  job        Job?          @relation(fields: [jobId], references: [id])
  /// Free-text reference kept from before there was a job list. Now optional.
  projectRef String?
  hours      Float
  /// Cost to the business per hour, taken at the moment the entry was made.
  /// Snapshotted rather than derived on read: a pay rise must not silently
  /// rewrite the cost of work that was done last year.
  costRate   Float         @default(0)
  /// The voucher that absorbed this time into the ledger. Set once; a
  /// timesheet with a voucher cannot be posted again or edited.
  entryId    String?
  entry      JournalEntry? @relation(fields: [entryId], references: [id])
  notes      String?
  createdAt  DateTime      @default(now())

  @@index([companyId])
  @@index([employeeId])
  @@index([jobId])
  @@index([entryId])
}

/// HR — Performance appraisal (FSD HR-14)
model Appraisal {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period     String // e.g. "2026 H1"
  rating     Int // 1..5
  goals      String?
  feedback   String?
  reviewedBy String
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([employeeId])
}

/// Uploaded employee documents (Emirates ID copy, passport, visa, photo, etc.)
model EmployeeDocument {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category   String // Photo | Emirates ID | Passport | Visa | Labour Card | Certificate | Contract | Other
  fileName   String // original name
  storedName String // name on disk
  mimeType   String
  size       Int
  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

/// Admin-definable custom fields for employees (per tenant).
model CustomFieldDef {
  id        String             @id @default(cuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entity    String             @default("Employee")
  label     String
  fieldKey  String
  type      String             @default("text") // text | number | date | select
  options   String? // comma-separated for select
  order     Int                @default(0)
  values    CustomFieldValue[]
  createdAt DateTime           @default(now())

  @@unique([tenantId, entity, fieldKey])
  @@index([tenantId])
}

model CustomFieldValue {
  id         String         @id @default(cuid())
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fieldDefId String
  fieldDef   CustomFieldDef @relation(fields: [fieldDefId], references: [id], onDelete: Cascade)
  value      String

  @@unique([employeeId, fieldDefId])
  @@index([fieldDefId])
}

/// Generic master data lists (Departments, Designations, Grades, etc.), per tenant.
model MasterItem {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      String // Department | Designation | Grade | Nationality | ...
  value     String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, type, value])
  @@index([tenantId, type])
}

/// Connection settings to an on-prem Tally (TallyPrime / Tally.ERP 9) HTTP gateway, per company.
model TallyConfig {
  id           String    @id @default(cuid())
  companyId    String    @unique
  host         String    @default("localhost")
  port         Int       @default(9000)
  tallyCompany String? // the company name inside Tally
  lastSyncAt   DateTime?
  lastSyncInfo String?
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())
}

/// A customer or supplier. Free-typed names produced duplicates and made
/// outstanding impossible to total, so parties are a master record.
model Party {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code          String
  name          String
  type          String         @default("Customer") // Customer | Supplier | Both
  /// UAE Tax Registration Number — required on a tax invoice.
  trn           String?
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  /// Payment terms in days, used to flag an invoice as overdue.
  creditDays    Int            @default(0)
  isActive      Boolean        @default(true)
  entries       JournalEntry[]
  jobs          Job[]
  cheques       Cheque[]
  retentions    Retention[]
  createdAt     DateTime       @default(now())

  @@unique([companyId, code])
  @@index([companyId])
}

/// A cheque held or issued, most of them post-dated.
///
/// A large share of UAE business settles this way: a client hands over six
/// cheques dated monthly, and they sit in a drawer until each date comes round.
/// With nowhere to record them there are only two options and both are wrong —
/// post them on receipt and the bank balance is overstated for months, or keep
/// them out of the books and every one of those invoices reads as overdue while
/// nobody can see what cash is actually coming.
///
/// A cheque is a bearer instrument, so where the paper is matters as much as
/// the figure. `heldBy` is custody, not bookkeeping.
/// Money withheld against a contract until the work is proven.
///
/// Retention is taken out of essentially every certified payment in UAE
/// contracting — five or ten per cent — and comes back in two pieces: half at
/// practical completion, half once the defects liability period ends, usually a
/// year later. It runs in both directions at once: a client holds it from you,
/// and you hold it from your own subcontractors.
///
/// The money is already in the ledger when the certificate is posted; what was
/// missing was any record of what is held, against which job, and when it can
/// be asked for. Without that it lives in a spreadsheet and gets forgotten,
/// which is expensive — this is commonly five to ten per cent of turnover.
model Retention {
  id         String        @id @default(cuid())
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Receivable: a client holds it from us. Payable: we hold it from a
  /// subcontractor. Both are live on the same contract at the same time.
  direction  String // Receivable | Payable
  /// The certificate or invoice it was withheld from.
  reference  String
  jobId      String?
  job        Job?          @relation(fields: [jobId], references: [id])
  partyId    String?
  party      Party?        @relation(fields: [partyId], references: [id])
  partyName  String?
  amount     Float
  /// The rate applied, kept for the record rather than recomputed.
  percent    Float?
  /// When it can be asked for. The question the register exists to answer.
  dueDate    DateTime
  /// Practical completion | Defects liability | Other
  stage      String        @default("Defects liability")
  /// Held | Released | Written off
  status     String        @default("Held")
  releasedOn DateTime?
  /// The voucher that moved it out of retention once released.
  entryId    String?
  entry      JournalEntry? @relation(fields: [entryId], references: [id])
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([dueDate])
  @@index([jobId])
  @@index([partyId])
  @@index([entryId])
}

model Cheque {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Received from a customer, or issued to a supplier.
  direction   String // Received | Issued
  chequeNo    String
  bankName    String?
  /// The date it can be banked. The whole point of a post-dated cheque, and
  /// what every question about one is really asking.
  chequeDate  DateTime
  amount      Float
  partyId     String?
  party       Party?        @relation(fields: [partyId], references: [id])
  /// Snapshotted, so a printed list still names the party.
  partyName   String?
  /// In hand | Deposited | Cleared | Bounced | Returned
  status      String        @default("In hand")
  /// Who physically holds the paper.
  heldBy      String?
  depositedOn DateTime?
  settledOn   DateTime?
  /// The voucher that moved it out of Cheques in Hand once it settled.
  entryId     String?
  entry       JournalEntry? @relation(fields: [entryId], references: [id])
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  /// One cheque number per bank per direction — the same number can legitimately
  /// appear again from a different bank.
  @@unique([companyId, direction, bankName, chequeNo])
  @@index([companyId])
  @@index([status])
  @@index([chequeDate])
  @@index([partyId])
  @@index([entryId])
}

/// A job, contract or project — the thing the MD asks about by name.
/// Costs and revenue are tagged to it so 'did we make money on the ADNOC job?'
/// has an answer. BRD FIN-06.
model Job {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code          String // e.g. J-2601
  name          String
  /// A job and a project are the same record here. `type` is only the word the
  /// client uses for it, so one table serves a fixed-price contract, a service
  /// call and an internal cost pool without a second entity to keep in step.
  type          String        @default("Contract") // Contract | Project | Service call | AMC | Internal
  /// Contract -> package -> variation. Costs are tagged on the leaf and the
  /// report rolls them up, which is how a main contract shows a true total
  /// without anything being posted against the parent itself.
  parentId      String?
  parent        Job?          @relation("JobTree", fields: [parentId], references: [id])
  children      Job[]         @relation("JobTree")
  /// The customer this job is for, so a job report can name them.
  partyId       String?
  party         Party?        @relation(fields: [partyId], references: [id])
  /// What the job was sold for, and what it was expected to cost.
  contractValue Float         @default(0)
  budgetCost    Float         @default(0)
  startDate     DateTime?
  endDate       DateTime?
  status        String        @default("Open") // Open | On hold | Completed | Closed
  notes         String?
  lines         JournalLine[]
  timesheets    Timesheet[]
  retentions    Retention[]
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())

  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentId])
}

/// A cost centre — the second costing dimension, for what belongs to the
/// business rather than to a customer's job.
///
/// Both ERPNext and Odoo keep this separate from the project: ERPNext as a
/// Cost Center alongside Project, Odoo as an analytic account with no project
/// attached. It is what lets the workshop, the vehicles and the head office be
/// reported on when there is no contract to charge them to.
model CostCentre {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code      String // e.g. CC-01
  name      String
  /// Departments roll up into a division the same way jobs roll up.
  parentId  String?
  parent    CostCentre?   @relation("CostCentreTree", fields: [parentId], references: [id])
  children  CostCentre[]  @relation("CostCentreTree")
  lines     JournalLine[]
  notes     String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())

  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentId])
}

/// A UAE Corporate Tax computation for one company, for one tax period.
///
/// Federal Decree-Law 47 of 2022, in force for financial years beginning on or
/// after 1 June 2023. Nine per cent on taxable income above AED 375,000, nil
/// below it, and the return is due within nine months of the period end.
///
/// This is a working paper, not a filing. The return itself goes to the FTA
/// through EmaraTax; what this does is take the accounting profit straight from
/// the ledger, hold the adjustments beside it with a reason for each, and show
/// the arithmetic the way the FTA lays it out — so the figure typed into
/// EmaraTax can be traced back to the books that produced it.
///
/// One per company per period: a group files separately for each legal entity
/// unless it has formed a tax group, which is a different thing again.
model CorporateTaxReturn {
  id                   String                   @id @default(cuid())
  companyId            String
  company              Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// The tax period, normally the financial year.
  periodFrom           DateTime
  periodTo             DateTime
  /// Draft | Filed
  status               String                   @default("Draft")
  /// Small Business Relief elected for this period. A business with revenue at
  /// or under AED 3,000,000 may elect to be treated as having no taxable
  /// income. Available for periods ending on or before 31 December 2029.
  sbrElected           Boolean                  @default(false)
  /// Losses from earlier periods available to set against this one. Capped at
  /// 75% of taxable income; the remainder carries forward again.
  lossesBroughtForward Float                    @default(0)
  /// What was actually submitted, so the working paper can be tied to it.
  filedOn              DateTime?
  filedRef             String?
  notes                String?
  adjustments          CorporateTaxAdjustment[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@unique([companyId, periodFrom, periodTo])
  @@index([companyId])
  @@index([status])
}

/// One line of the reconciliation from accounting profit to taxable income.
///
/// Each carries its own reason, because in two years' time the question an
/// auditor or the FTA asks is not what the number was but why.
model CorporateTaxAdjustment {
  id       String             @id @default(cuid())
  returnId String
  return   CorporateTaxReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  /// Add back | Deduct | Exempt income
  kind     String
  /// What it is, in the accountant's words.
  label    String
  amount   Float
  /// The FTA heading it belongs under, so the return can be filled in.
  category String
  notes    String?

  @@index([returnId])
}
