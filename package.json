{
  "name": "wb-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/set-db-provider.mjs && prisma generate && next build",
    "start": "node scripts/set-db-provider.mjs && prisma db push --skip-generate && node prisma/seed.mjs && next start",
    "lint": "next lint",
    "postinstall": "node scripts/set-db-provider.mjs && prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:prod": "node scripts/prod-schema.mjs && prisma studio --schema prisma/.prod.prisma",
    "db:prod:pull": "node scripts/prod-schema.mjs && prisma db pull --print --schema prisma/.prod.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "lucide-react": "^0.454.0",
    "next": "^15.5.25",
    "prisma": "^5.22.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
